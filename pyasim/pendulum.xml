<mujoco>
  <option timestep="0.007" integrator="implicit" gravity="0 0 -9.81"/>
  <!-- <flag sensornoise="enable"/> -->
  <worldbody>
    <light diffuse=".5 .5 .5" pos="0 0 5" dir="0 0 -1"/>
  <geom type="plane" size="1 1 0.1" rgba=".9 0 0 1"/>
  <body name="pin_B" pos="0 0 1.5" euler="5 45 0">
    <geom type="sphere" size=".1" rgba=".9 .9 .9 1"/>
    <joint name="pin" type="hinge" axis="0 1 0" pos="0 0 0"
    stiffness="0" damping="0" springref="0"/>
    <body name="bar" pos="0 0 -0.5" euler="0 0 0">
      <geom type="cylinder" size=".05 .5" rgba="0 .9 0 1"/>
      <body name="ball" pos="0 0 -.6" euler="0 0 0">
        <geom type="sphere" size=".1" rgba=".9 0 .9 1" mass="0.01"/>
      </body>
    </body>
  </body>
  </worldbody>
  <actuator>
    <motor joint="pin" name="torque" gear="1" ctrllimited="true" ctrlrange="-75 75"/>
    <position name="pservo" joint="pin" kp="0"/>
    <velocity name="vservo" joint="pin" kv="0"/>
    <!-- <pid name="pid_ctrl" joint="pin" kp="40" ki="0" kd="4"/> -->
  </actuator>
  <sensor>
    <jointpos joint="pin" noise=".2"/>
    <jointvel joint="pin" noise="1"/>
  </sensor>
</mujoco>
